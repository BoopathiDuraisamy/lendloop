# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
!n8n/.env.example
!n8n/secrets.env.example

# convex local/anonymous deployment state
/.convex

# local brief, not part of the repo
/note.txt

# Notification secrets for the n8n credential importer (passwords, tokens)
/n8n/secrets.env
/n8n/smtp.env
