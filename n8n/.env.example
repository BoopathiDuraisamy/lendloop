# Copy to n8n/.env  (docker compose reads it). Never commit the real file.

# Encrypts credentials stored in n8n's database. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me

# Shared HMAC secret for LendLoop <-> n8n. Must equal Convex's N8N_WEBHOOK_SECRET.
# Generate: openssl rand -hex 32
LENDLOOP_HMAC_SECRET=change-me

# Convex HTTP actions URL as seen from inside the n8n container.
#  - local Convex (`npx convex dev --local`):  http://host.docker.internal:3211
#  - Convex cloud:                            https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

GENERIC_TIMEZONE=UTC

# Notifications: "mock" logs messages (default); "email" sends via the "LendLoop SMTP"
# credential (set it up with n8n/smtp.env + `docker compose run --rm n8n-smtp`).
LENDLOOP_NOTIFY_MODE=mock
LENDLOOP_MAIL_FROM=LendLoop <you@gmail.com>
