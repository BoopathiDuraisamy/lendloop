# Copy to n8n/secrets.env (git-ignored). Read ONLY by the one-shot
# `docker compose run --rm n8n-credentials`, which stores each value as an
# encrypted n8n credential. Leave a section blank to skip that channel.

# --- Email (SMTP) ---------------------------------------------------------
# Gmail: App Password at https://myaccount.google.com/apppasswords (needs 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Slack (private DMs to the lender/borrower, looked up by email) -------
# Slack app "Bot User OAuth Token" with scopes: chat:write, users:read, users:read.email
SLACK_BOT_TOKEN=

# --- Discord (anonymized activity feed in one channel) --------------------
# Channel settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=
