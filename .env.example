# ---- Next.js (.env.local) ----------------------------------------------
# Written automatically by `npx convex dev`:
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk → Dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---- Convex deployment env (NOT this file) ------------------------------
# Set these with `npx convex env set NAME value` (they live on the Convex deployment):
#   CLERK_JWT_ISSUER_DOMAIN   https://<your-app>.clerk.accounts.dev
#   ADMIN_EMAILS              you@example.com   (comma-separated; granted admin on sign-in)
#   N8N_WEBHOOK_SECRET        <same value as LENDLOOP_HMAC_SECRET in n8n/.env>
#   N8N_REQUEST_WEBHOOK_URL   http://localhost:5678/webhook/lendloop-request-events
#   APP_URL                   http://localhost:3000
